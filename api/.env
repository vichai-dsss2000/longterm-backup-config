
# Environment Variables for testing
DATABASE_URL=sqlite:///./longterm_backup_config.db
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Device Encryption Key for credential storage
# Generated using Fernet symmetric encryption
# To regenerate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVICE_ENCRYPTION_KEY=mOOFOxbPIx1j5Ej9z3xK_1L2vN3pQ4rS5tU6vW7xY8zA9bB0cC1dD2eE3fF4gG5hH

# SMTP Configuration
SMTP_SERVER=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com

# SFTP Configuration
DEFAULT_SFTP_SERVER=your-backup-server.com
DEFAULT_SFTP_USERNAME=test_user
DEFAULT_SFTP_PASSWORD=test_password
DEFAULT_SFTP_PORT=22
DEFAULT_BACKUP_PATH=/backups/network-devices

# Application Settings
MAX_CONCURRENT_BACKUPS=10
BACKUP_RETENTION_DAYS=90
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001,127.0.0.1:3000,127.0.0.1:8000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TIMES=100
RATE_LIMIT_SECONDS=60
LOGIN_RATE_LIMIT_TIMES=5
LOGIN_RATE_LIMIT_SECONDS=300