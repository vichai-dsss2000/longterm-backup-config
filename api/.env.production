# Production Environment Variables
# Copy and update these for production deployment

# Security
DATABASE_URL=sqlite:///./longterm_backup_config.db
SECRET_KEY=change-this-to-a-secure-random-key-in-production
DEVICE_ENCRYPTION_KEY=change-this-to-a-secure-fernet-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Environment
ENVIRONMENT=production
LOG_LEVEL=WARNING

# CORS - Update with your domain
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TIMES=100
RATE_LIMIT_SECONDS=60
LOGIN_RATE_LIMIT_TIMES=5
LOGIN_RATE_LIMIT_SECONDS=300

# SMTP for notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# SFTP Backup Storage
DEFAULT_SFTP_SERVER=backup.yourdomain.com
DEFAULT_SFTP_USERNAME=backup_user
DEFAULT_SFTP_PASSWORD=your-backup-password
DEFAULT_SFTP_PORT=22
DEFAULT_BACKUP_PATH=/backups/network-devices

# Backup Settings
MAX_CONCURRENT_BACKUPS=10
BACKUP_RETENTION_DAYS=90
