# Docker Environment Variables
# Copy these values to .env before running docker-compose

# Security Keys (REQUIRED - Generate with openssl rand -hex 32)
SECRET_KEY=longterm_backup_config-1234567890abcdef
DEVICE_ENCRYPTION_KEY=gK96Z_rfCkZzqR2nJUUGBBxz-tO9N0anufAzujPYeCI=

# Database
DATABASE_URL=sqlite:///./longterm_backup_config.db

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backup Settings
MAX_CONCURRENT_BACKUPS=5
BACKUP_RETENTION_DAYS=90

# SMTP (optional - for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# SFTP (optional - for backup storage)
DEFAULT_SFTP_SERVER=backup.yourdomain.com
DEFAULT_SFTP_USERNAME=backup_user
DEFAULT_SFTP_PASSWORD=your-password
DEFAULT_SFTP_PORT=22
DEFAULT_BACKUP_PATH=/backups
