# Environment variables for Docker Compose
# Copy this file to .env and update with your values

# =============================================================================
# Security - CHANGE THESE VALUES IN PRODUCTION!
# =============================================================================

# JWT Secret Key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Database passwords
DB_ROOT_PASSWORD=your-strong-root-password-change-this
DB_PASSWORD=your-strong-db-password-change-this

# Redis password (if using Redis)
REDIS_PASSWORD=your-redis-password-change-this

# =============================================================================
# Application Configuration
# =============================================================================

# Backend API
MAX_CONCURRENT_BACKUPS=5
BACKUP_STORAGE_PATH=/app/backups
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://frontend

# =============================================================================
# Email Configuration (optional)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# =============================================================================
# Backup Storage Configuration
# =============================================================================
SFTP_SERVER_IP=10.10.100.10
SFTP_USERNAME=backup_user
SFTP_PASSWORD=your-sftp-password
SFTP_PORT=22

# =============================================================================
# Monitoring & Alerts (optional)
# =============================================================================
ALERT_EMAIL=admin@yourdomain.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
