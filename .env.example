# Environment variables for Docker Compose
# Copy this file to .env and update with your values

# =============================================================================
# Security - CHANGE THESE VALUES IN PRODUCTION!
# =============================================================================

# Environment (development or production)
ENVIRONMENT=development

# JWT Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Encryption Key for sensitive credentials (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-fernet-encryption-key-change-this

# Database passwords
DB_ROOT_PASSWORD=your-strong-root-password-change-this
DB_PASSWORD=your-strong-db-password-change-this
DATABASE_URL=mysql+pymysql://backup_user:your-strong-db-password-change-this@db:3306/backup_db

# Redis password (if using Redis)
REDIS_PASSWORD=your-redis-password-change-this

# =============================================================================
# Security - Password Policy
# =============================================================================
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# =============================================================================
# Security - Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TIMES=100
RATE_LIMIT_SECONDS=60
LOGIN_RATE_LIMIT_TIMES=5
LOGIN_RATE_LIMIT_SECONDS=300

# =============================================================================
# Security - Account Lockout
# =============================================================================
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
SESSION_TIMEOUT_MINUTES=60
MAX_CONCURRENT_SESSIONS=3

# =============================================================================
# Application Configuration
# =============================================================================

# Backend API
MAX_CONCURRENT_BACKUPS=5
BACKUP_STORAGE_PATH=/app/backups
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://frontend

# =============================================================================
# Email Configuration (optional)
# =============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_USE_TLS=true

# =============================================================================
# Backup Storage Configuration
# =============================================================================
DEFAULT_SFTP_SERVER=10.10.100.10
DEFAULT_SFTP_USERNAME=backup_user
DEFAULT_SFTP_PASSWORD=your-sftp-password
DEFAULT_SFTP_PORT=22
DEFAULT_BACKUP_PATH=/backups/network-devices
BACKUP_RETENTION_DAYS=90

# =============================================================================
# Monitoring & Alerts (optional)
# =============================================================================
ALERT_EMAIL=admin@yourdomain.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
